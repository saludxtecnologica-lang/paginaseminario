{
  "crons": [
    {
      "path": "/api/cron/reset-cycle",
      "schedule": "0 1 * * 6"
    }
  ],
  "rewrites": [
    {
      "source": "/api/login",
      "destination": "/api/auth/login"
    },
    {
      "source": "/api/logout",
      "destination": "/api/auth/logout"
    },
    {
      "source": "/api/me",
      "destination": "/api/auth/me"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ]
}
