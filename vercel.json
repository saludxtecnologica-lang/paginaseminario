{
  "version": 2,
  "functions": {
    "app.cjs": {
      "includeFiles": "{styles.css,admin.css,app.js,admin.js,index.html,admin.html,assets/**,public/**}"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/app.cjs"
    },
    {
      "src": "/admin",
      "dest": "/admin.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/app.cjs"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
